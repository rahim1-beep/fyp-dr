# --- Data (never committed) ---
data/raw/
data/processed/
data/interim/
*.npy
*.npz

# --- Model artefacts ---
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors

# --- Credentials ---
kaggle.json
.kaggle/
.env
.env.*
!.env.example

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Node / Next.js ---
node_modules/
.next/
out/
frontend/.env*.local
*.tsbuildinfo

# --- OS / editors ---
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# --- Run outputs: keep the small stuff, drop the big stuff ---
runs/**/checkpoints/
runs/**/*.pth
runs/**/gradcam/
# Explicitly KEEP (these are the record of the project):
!runs/**/config.yaml
!runs/**/metrics.json
!runs/**/train_log.csv

# --- Analysis artefacts (Phase 5/6/7): TRACKED, deliberately ---
# analysis/<name>/ holds JSON plus figures produced by an analysis notebook. These are
# NOT reproducible from the repo -- regenerating one needs best.pth (gitignored), the
# 0.8 GB cache, and a GPU session -- so they are records, not derivatives, and they are
# committed including the PNGs (DECISION-055). Checkpoints never are:
analysis/**/*.pth
analysis/**/*.npz

# --- Kaggle code bundle (regenerated by notebooks/make_bundle.py) ---
dist/

# --- Scratch ---
scratch/
tmp/

# Frontend test fixture IMAGES are generated, not authored: `python -m fixtures.build_fixtures`
# rebuilds and re-verifies them. They are derived from data/raw/ (itself ignored, line 2),
# so committing them would put EyePACS pixels in the repo by the back door — and one of
# them is a deliberately oversized 20 MB+ file for the 413 path.
# The script, README, fixtures.json and expected/*.json ARE committed: they are the
# contract, and the frontend can be built against them with no images present.
fixtures/*.jpeg
fixtures/*.jpg
fixtures/*.png

# Browser-verification scratch written by the Playwright MCP server
.playwright-mcp/

# The ONE committed checkpoint: the deployed model, so a cloned repo can run the app
# (DECISION-074, a user decision). Every other .pth stays ignored by the rules above.
!runs/phase4_stage3_arm_e_efficientnet_b0/best.pth
